{
    "name": "Discord-Bot-Template",
    "description": "Using TypeScript 7, Bun & Seyfert",
    "version": "0.0.1",
    "main": "app/index.ts",
    "type": "commonjs",
    "scripts": {
        "biome:format": "bunx @biomejs/biome format --write",
        "biome:lint": "bunx @biomejs/biome lint --write",
        "biome:check": "bunx @biomejs/biome check --write",
        "db:generate": "bunx drizzle-kit generate",
        "db:migrate": "bunx drizzle-kit migrate",
        "db:push": "bunx drizzle-kit push",
        "db:studio": "bunx drizzle-kit studio",
        "start": "bun app/index.ts",
        "ts:build": "bunx tsc",
        "ts:check": "bunx tsc --noEmit",
        "ts:dev": "bunx tsc -w"
    },
    "dependencies": {
        "@libsql/client": "^0.18.0",
        "@slipher/cooldown": "^1.0.0",
        "drizzle-orm": "^0.45.3",
        "mongoose": "^9.10.3",
        "seyfert": "^5.1.0",
        "yunaforseyfert": "^1.2.4"
    },
    "devDependencies": {
        "@biomejs/biome": "^2",
        "@types/bun": "^1",
        "@types/node": "^26",
        "drizzle-kit": "^0",
        "typescript": "^5"
    }
}
